# ── DATABASE ─────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/nexgenlegal?schema=public"

# ── SERVER ───────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
APP_URL=https://your-app.onrender.com
FRONTEND_URL=https://your-app.onrender.com

# ── JWT ──────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ── ANTHROPIC (NexGen Ultra) ─────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── STRIPE ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_SOLO=price_...
STRIPE_PRICE_FIRM=price_...
STRIPE_PRICE_GOVERNMENT=price_...

# ── OAUTH2 — GOOGLE ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=...
GOOGLE_CALLBACK_URL=https://your-app.onrender.com/api/auth/google/callback

# ── OAUTH2 — MICROSOFT ───────────────────────────────────────────
MICROSOFT_CLIENT_ID=...
MICROSOFT_CLIENT_SECRET=...
MICROSOFT_CALLBACK_URL=https://your-app.onrender.com/api/auth/microsoft/callback

# ── EMAIL ────────────────────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG....
EMAIL_FROM=noreply@corverxis.com
SUPPORT_EMAIL=support@corverxis.com

# ── ENCRYPTION ───────────────────────────────────────────────────
ENCRYPTION_KEY=32-byte-hex-key-for-aes-256-encryption

# ── ACCOUNTING OAUTH ─────────────────────────────────────────────
QUICKBOOKS_CLIENT_ID=...
QUICKBOOKS_CLIENT_SECRET=...
QUICKBOOKS_CALLBACK_URL=https://your-app.onrender.com/api/accounting/quickbooks/callback
QUICKBOOKS_SANDBOX=false

XERO_CLIENT_ID=...
XERO_CLIENT_SECRET=...
XERO_CALLBACK_URL=https://your-app.onrender.com/api/accounting/xero/callback

# ── RATE LIMITING ─────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── CORS ─────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://your-app.onrender.com,https://nexgenlegal.com
